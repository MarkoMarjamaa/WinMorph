ACAnimContextCfgDlg DIALOG 18, 18, 99, 63
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Animation configuration"
BEGIN
	LTEXT "Play mode:", -1, 8, 8, 36, 12, WS_CHILD | WS_VISIBLE | WS_GROUP
	CONTROL "", ID_PLAYMODE, "COMBOBOX", CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_TABSTOP, 48, 8, 44, 44
	LTEXT "Play delay:", -1, 8, 24, 40, 12, WS_CHILD | WS_VISIBLE | WS_GROUP
	CONTROL "", ID_PLAYDELAY, "EDIT", ES_RIGHT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 48, 24, 32, 12
	LTEXT "ms.", -1, 80, 24, 16, 12, WS_CHILD | WS_VISIBLE | WS_GROUP
	PUSHBUTTON "Ok", IDOK, 16, 44, 28, 12, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 52, 44, 32, 12, WS_CHILD | WS_VISIBLE | WS_TABSTOP
END


